<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#EDF3F8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡 Walkie-Talkie" android:textColor="#102A43" android:textSize="27sp" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conecte-se ao servidor da mesma rede Wi-Fi." android:textColor="#52687B" android:gravity="center" android:layout_marginBottom="26dp" />
        <EditText android:id="@+id/etIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="IP do servidor (ex.: 192.168.0.10)" android:inputType="text" android:singleLine="true" android:autofillHints="none" android:padding="14dp" android:backgroundTint="#9AABBA" />
        <EditText android:id="@+id/etId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ID recebido no cadastro" android:inputType="text" android:singleLine="true" android:layout_marginTop="10dp" android:padding="14dp" android:backgroundTint="#9AABBA" />
        <EditText android:id="@+id/etSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Sua senha" android:inputType="textPassword" android:singleLine="true" android:layout_marginTop="10dp" android:padding="14dp" android:backgroundTint="#9AABBA" />
        <Button android:id="@+id/btnConectar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conectar" android:textAllCaps="false" android:layout_marginTop="18dp" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desconectado" android:textColor="#52687B" android:gravity="center" android:padding="16dp" />
        <Button android:id="@+id/btnFalar" android:layout_width="match_parent" android:layout_height="72dp" android:text="Segure para falar" android:textAllCaps="false" android:textSize="18sp" android:enabled="false" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="O áudio é transmitido para os outros aparelhos conectados à sala geral." android:textColor="#52687B" android:gravity="center" android:padding="14dp" />
    </LinearLayout>
</ScrollView>
